# 복사해서 deploy/.env로 만들고 값을 채워요. .env는 커밋하지 않아요(루트 .gitignore).
# 비밀값 만들기 예: openssl rand -base64 48

# 접속 주소 (DNS가 이 서버를 가리켜야 HTTPS 인증서가 발급돼요)
DOMAIN=mspace.example.ac.kr

DB_PASSWORD=change-me-long-random
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes

# 첫 배포 때만: 관리자(조교) 계정을 만들어요. 첫 로그인 뒤 비밀번호를 바꾸게 되고, 그다음 이 세 줄은 지워요
BOOTSTRAP_ADMIN_STUDENT_NO=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=관리자

# 이미지 태그 (릴리즈 버전)
APP_VERSION=0.4.0
